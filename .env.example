# Qumanity — environment configuration template.
# Copy to ".env" and fill in real values. NEVER commit the real ".env".
#   cp .env.example .env

# ── Environment ──────────────────────────────────────────────────────────────
FLASK_ENV=production
# FLASK_DEBUG=false

# ── Secrets ──────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
# Key used to encrypt Qoin wallet contents at rest.
QOIN_WALLET_ENCRYPTION_KEY=change-me-to-a-long-random-string

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite (default, prototype). For production prefer PostgreSQL.
DATABASE_URL=sqlite:///indiaq.db
# DATABASE_URL=postgresql://user:password@host:5432/quantumbox

# ── Mail (optional — account recovery / notifications) ───────────────────────
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=your-email@gmail.com

# ── Session / cookies ────────────────────────────────────────────────────────
# Set true when served over HTTPS (recommended in production).
SESSION_COOKIE_SECURE=true

# ── Public URL (referral links & QR codes) ───────────────────────────────────
# PUBLIC_BASE_URL=https://qumanity.in

# ── Razorpay (dashboard.razorpay.com → Settings → API Keys / Webhooks) ───────
# Test mode keys start with rzp_test_; live keys start with rzp_live_
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
# Razorpay webhook secret from Dashboard → Webhooks
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx
# Merchant UPI VPA for direct UPI QR (Razorpay Dashboard → Settings → UPI).
# Razorpay TEST mode (auto-confirms payments): success@razorpay
# Any of these names work: DONATION_UPI_VPA, RAZORPAY_UPI_VPA, UPI_VPA, MERCHANT_UPI_VPA
# If omitted, the app tries to discover VPA automatically via Razorpay API.
# DONATION_UPI_VPA=success@razorpay

SESSION_COOKIE_SAMESITE=Lax

# ── Server (local development) ───────────────────────────────────────────────
HOST=0.0.0.0
# macOS AirPlay often occupies 5000 — use 5001 locally
FLASK_RUN_PORT=5001
PORT=5001
