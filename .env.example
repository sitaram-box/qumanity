# Qumanity — environment configuration template.
# Copy to ".env" and fill in real values. NEVER commit the real ".env".
#   cp .env.example .env

# ── Environment ──────────────────────────────────────────────────────────────
FLASK_ENV=production
# FLASK_DEBUG=false

# ── Secrets ──────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
# Key used to encrypt Qoin wallet contents at rest.
QOIN_WALLET_ENCRYPTION_KEY=change-me-to-a-long-random-string

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite (default, prototype). For production prefer PostgreSQL.
DATABASE_URL=sqlite:///indiaq.db
# DATABASE_URL=postgresql://user:password@host:5432/quantumbox

# ── Mail (optional — account recovery / notifications) ───────────────────────
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=your-email@gmail.com

# ── Session / cookies ────────────────────────────────────────────────────────
# Set true when served over HTTPS (recommended in production).
SESSION_COOKIE_SECURE=true

# ── Public URL (referral links & QR codes) ───────────────────────────────────
# PUBLIC_BASE_URL=https://qumanity.in

# ── Razorpay (test mode keys from dashboard.razorpay.com) ────────────────────
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
# RAZORPAY_KEY_SECRET=your_secret_key

SESSION_COOKIE_SAMESITE=Lax

# ── Server ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=5000
