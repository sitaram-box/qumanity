  'theme': 'base',
  'themeVariables': {
    'fontFamily': 'Arial, sans-serif',
    'fontSize': '16px',
    'primaryColor': '#2D5016',
    'primaryTextColor': '#ffffff',
    'primaryBorderColor': '#2D5016',
    'lineColor': '#475569',
