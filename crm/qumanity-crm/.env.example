# NocoBase CRM — copy to .env and match Flask JWT_SECRET
#   cp .env.example .env

APP_PORT=3000
APP_HOST=0.0.0.0
APP_KEY=qumanity-crm-dev-key-change-in-production

# PostgreSQL (same database as Qumanity migration)
DB_DIALECT=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=qumanity_crm
DB_USER=your_macos_username
DB_PASSWORD=

# JWT — must match Flask .env JWT_SECRET
JWT_SECRET=your_super_secret_jwt_key_change_this

# Qumanity integration
QUMANITY_API_URL=http://localhost:5000/api
QUMANITY_WEBHOOK_SECRET=your_webhook_secret_here

LOG_LEVEL=info

# Redis (optional)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
